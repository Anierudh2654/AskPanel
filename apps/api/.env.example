DATABASE_URL=sqlite+aiosqlite:///./askpanel.db
JWT_SECRET=replace-with-a-random-64-character-hex-secret
ADMIN_PASSWORD=replace-with-a-strong-random-password
CORS_ORIGINS=http://localhost:3000
# mock | nebius | openai | anthropic
LLM_PROVIDER=mock
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-latest
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
ENABLE_PROMPT_CACHE=false
PROMPT_VERSION=v1
CONTEXT_STRATEGY=relevant
CONTEXT_TOKEN_BUDGET=60000
CHECKPOINTS_KEEP=5
JUDGE_PROVIDER=openai
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_BASE_URL=https://api.openai.com/v1
DAILY_SPEND_LIMIT_USD=25
